{
  "name": "zerodep-svelte-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "简洁、灵活、易于维护的 Svelte 组件库",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "svelte": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    }
  },
  "scripts": {
    "dev": "node ../../scripts/dev-ui.mjs",
    "build": "node ../../scripts/generate-ui-exports.mjs && svelte-package -i src",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --test test/*.test.mjs",
    "test:consumer": "node --test test/consumer/*.test.mjs",
    "test:component": "vitest run"
  },
  "peerDependencies": {
    "@lucide/icons": "^1.48.0",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@lucide/icons": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "catalog:"
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:",
    "@internationalized/date": "catalog:",
    "decimal.js": "catalog:",
    "zerodep-css": "catalog:",
    "zerodep-css-svelte": "catalog:",
    "zod": "catalog:"
  }
}
