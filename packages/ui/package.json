{
  "name": "zerodep-svelte-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "简洁、灵活、易于维护的 Svelte 组件库",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "svelte-package --watch",
    "build": "svelte-package",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {
    "zerodep-css": "catalog:",
    "zerodep-css-svelte": "catalog:"
  }
}
